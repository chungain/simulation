{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://factory-simulation/scenario.schema.json",
  "title": "봉제 공장 시나리오",
  "description": "공장 하나를 표현하는 시나리오 파일. layout · zones · stages · flow · events 로 구성된다.",
  "type": "object",
  "required": ["id", "name", "layout", "stages", "zones", "flow", "events"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "시나리오 id. 파일 이름(<id>.json)과 같아야 한다. 영문 소문자, 숫자, - 만 쓴다."
    },
    "name": { "type": "string", "minLength": 1, "description": "화면에 보이는 공장 이름" },
    "description": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["factory", "supply-chain"],
      "description": "시나리오 종류. factory = 공장 안, supply-chain = 바이어·벤더 사이 오더 흐름. 기본 factory"
    },
    "layout": {
      "type": "object",
      "description": "맵 크기와 소품·사람 배치",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "number", "minimum": 200, "maximum": 10000 },
        "height": { "type": "number", "minimum": 200, "maximum": 10000 },
        "start": { "$ref": "#/definitions/point", "description": "플레이어 시작 위치. 없으면 맵 가운데" },
        "areas": {
          "type": "array",
          "description": "회사·현장 경계 같은 큰 영역(바이어 본사, 벤더 사무실 등). 구역보다 아래에 그린다",
          "items": { "$ref": "#/definitions/area" }
        },
        "props": {
          "type": "array",
          "items": { "$ref": "#/definitions/prop" }
        }
      }
    },
    "view": {
      "type": "object",
      "description": "둘러보기 화면 설정",
      "additionalProperties": false,
      "properties": {
        "playerSpeed": { "type": "number", "exclusiveMinimum": 0, "description": "플레이어 이동 속도(px/초). 기본 170" },
        "followSpan": { "type": "number", "minimum": 100, "description": "따라가기 기본 배율 = 화면 짧은 변 ÷ 이 값. 기본 420" },
        "tourDwell": { "type": "number", "exclusiveMinimum": 0, "description": "공정 투어에서 구역마다 머무는 시간(초). 기본 14" },
        "alertSeconds": { "type": "number", "exclusiveMinimum": 0, "description": "돌발 상황 알림이 떠 있는 시간(초). 기본 9" },
        "wipWarn": { "type": "integer", "minimum": 1, "description": "구역 재공 배지가 빨간색이 되는 개수. 기본 6" }
      }
    },
    "stages": {
      "type": "array",
      "description": "물건 상태(원단 롤, 연단, 재단물, 번들, 완성품, 박스 등)와 표시 모양",
      "minItems": 1,
      "items": { "$ref": "#/definitions/stage" }
    },
    "zones": {
      "type": "array",
      "description": "공장 구역. 배열 순서가 공정 투어 순서다. station 이 있으면 물건이 그 구역에서 처리된다.",
      "minItems": 1,
      "items": { "$ref": "#/definitions/zone" }
    },
    "flow": { "$ref": "#/definitions/flow" },
    "eventTiming": {
      "type": "object",
      "description": "돌발 상황을 하나씩 차례로 일으키는 방식. 있으면 각 돌발 상황의 interval 대신 이 값을 쓴다.",
      "required": ["gap"],
      "additionalProperties": false,
      "properties": {
        "gap": {
          "type": "array",
          "description": "자동 돌발 상황이 끝난 뒤 다음 것까지 [최소, 최대] 초",
          "items": { "type": "number", "exclusiveMinimum": 0 },
          "minItems": 2,
          "maxItems": 2
        },
        "afterManual": { "type": "number", "exclusiveMinimum": 0, "description": "버튼으로 일으킨 뒤 다음 자동 발생까지(초). 기본 45" }
      }
    },
    "events": {
      "type": "array",
      "description": "돌발 상황",
      "items": { "$ref": "#/definitions/event" }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-_]*$" },
    "scenarioId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "color": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
    "point": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "rect": {
      "type": "array",
      "description": "[x, y, 너비, 높이]",
      "items": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "number", "exclusiveMinimum": 0 }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "area": {
      "type": "object",
      "required": ["name", "rect"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "icon": { "type": "string", "maxLength": 8 },
        "rect": { "$ref": "#/definitions/rect" }
      }
    },
    "prop": {
      "type": "object",
      "required": ["type", "rect"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["machine", "table", "cutter", "iron", "rack", "rolls", "pallet", "cart", "truck", "desk", "board", "wall", "door", "worker", "manager"],
          "description": "소품 종류. worker·manager 는 작업자·관리직 사람"
        },
        "rect": { "$ref": "#/definitions/rect" },
        "label": { "type": "string" }
      }
    },
    "stage": {
      "type": "object",
      "required": ["id", "label", "shape"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "label": { "type": "string", "minLength": 1 },
        "shape": {
          "type": "string",
          "enum": ["roll", "layers", "pieces", "bundle", "shirt", "box", "doc", "container", "circle", "square"],
          "description": "표시 모양"
        },
        "color": { "$ref": "#/definitions/color", "description": "물건 색. 없으면 물건마다 받은 원단 색" },
        "size": { "type": "number", "minimum": 4, "maximum": 40, "description": "크기(px). 기본 14" },
        "mark": { "type": "string", "enum": ["check", "check-tape"], "description": "덧붙이는 표시. check = 흰 체크, check-tape = 노란 체크" }
      }
    },
    "station": {
      "type": "object",
      "description": "공정. time 이 있으면 처리 자리에서 time 초 동안, speed 가 있으면 라인을 따라 흐르며 처리된 뒤 stage 상태가 된다.",
      "required": ["stage"],
      "additionalProperties": false,
      "properties": {
        "time": { "type": "number", "exclusiveMinimum": 0, "description": "처리 시간(초)" },
        "speed": { "type": "number", "exclusiveMinimum": 0, "description": "라인 공정: 구역 안을 흐르는 속도(px/초). 있으면 time·capacity·slots 를 쓰지 않는다" },
        "variance": { "type": "number", "minimum": 0, "maximum": 1, "description": "처리 시간 편차 비율(0.2 = ±20%)" },
        "stage": { "type": "string", "description": "처리 후 물건 상태(stages 의 id)" },
        "workingStage": { "type": "string", "description": "처리 중에 보이는 물건 상태(stages 의 id). 없으면 처리 전 상태 그대로" },
        "capacity": { "type": "integer", "minimum": 1, "maximum": 50, "description": "동시에 처리하는 수(작업자·장비 수)" },
        "slots": {
          "type": "array",
          "description": "처리 중인 물건이 놓이는 위치. 없으면 구역 안에 자동 배치",
          "items": { "$ref": "#/definitions/point" }
        },
        "inspect": { "type": "boolean", "description": "검사 공정 여부. true 면 불량을 찾아낸다." },
        "defectRate": { "type": "number", "minimum": 0, "maximum": 1, "description": "기본 불량률" },
        "repair": { "type": "number", "exclusiveMinimum": 0, "description": "불량이면 이 시간(초) 동안 수선한 뒤 다시 검사한다. 없으면 불량은 버린다" }
      }
    },
    "content": {
      "type": "object",
      "description": "구역 설명 카드 문구",
      "additionalProperties": false,
      "properties": {
        "does": { "type": "string", "description": "이 구역에서 하는 일" },
        "people": { "type": "string", "description": "현장 사람들(쉼표로 구분)" },
        "data": { "type": "array", "items": { "type": "string" }, "description": "시스템에 남는 데이터" },
        "point": { "type": "string", "description": "개발·디자인 포인트" }
      }
    },
    "zone": {
      "type": "object",
      "required": ["id", "name", "rect"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "type": "string", "minLength": 1 },
        "icon": { "type": "string", "maxLength": 8, "description": "구역 아이콘(이모지 하나)" },
        "rect": { "$ref": "#/definitions/rect" },
        "hub": { "type": "boolean", "description": "데이터가 모이는 곳(사무실). 공정 구역과 점선으로 이어 그린다" },
        "wipWarn": { "type": "integer", "minimum": 1, "description": "이 구역 재공 배지가 빨간색이 되는 개수. 없으면 view.wipWarn" },
        "link": { "$ref": "#/definitions/scenarioId", "description": "이 구역 카드에서 열 다른 시나리오 id (예: 공장 생산 → standard-factory)" },
        "station": { "$ref": "#/definitions/station" },
        "content": { "$ref": "#/definitions/content" }
      }
    },
    "flow": {
      "type": "object",
      "description": "물건이 지나는 경로와 투입 설정",
      "required": ["spawnInterval", "path"],
      "additionalProperties": false,
      "properties": {
        "spawnInterval": { "type": "number", "exclusiveMinimum": 0, "description": "새 물건 투입 간격(초)" },
        "spawnStage": { "type": "string", "description": "투입될 때의 물건 상태(stages 의 id). 없으면 첫 번째 stage" },
        "speed": { "type": "number", "exclusiveMinimum": 0, "description": "통로 이동 속도(px/초). 기본 60" },
        "gap": { "type": "number", "minimum": 4, "description": "경로 위 물건 사이 최소 간격(px). 기본 22" },
        "fabrics": {
          "type": "array",
          "description": "물건마다 무작위로 받는 원단 색",
          "minItems": 1,
          "items": { "$ref": "#/definitions/color" }
        },
        "warmup": { "type": "number", "minimum": 0, "description": "시작 전에 미리 돌리는 시간(초). 끝나면 지표를 0으로 되돌린다" },
        "startTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "description": "게임 시각 시작(HH:MM). 기본 08:00" },
        "clockFormat": { "type": "string", "enum": ["time", "day"], "description": "게임 시각 표시. time = 08:00, day = n주차 n일. 기본 time" },
        "timeScale": { "type": "number", "exclusiveMinimum": 0, "description": "시뮬레이션 1초가 게임 시각 몇 초인지. 기본 60(1초 = 1분)" },
        "path": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/definitions/point" }
        }
      }
    },
    "effect": {
      "type": "object",
      "description": "돌발 상황의 영향",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "stopZones": {
          "type": "array",
          "items": { "type": "string" },
          "description": "정지시킬 구역 id"
        },
        "spawnMultiplier": { "type": "number", "minimum": 0, "description": "투입 배수(2 = 두 배로 투입, 0 = 투입 중단)" },
        "defectRate": { "type": "number", "minimum": 0, "maximum": 1, "description": "검사 불량률을 이 값으로 바꾼다" },
        "defectZones": {
          "type": "array",
          "items": { "type": "string" },
          "description": "defectRate 를 적용할 검사 구역 id. 없으면 모든 검사 구역"
        }
      }
    },
    "event": {
      "type": "object",
      "required": ["id", "label", "duration", "effect"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "label": { "type": "string", "minLength": 1 },
        "icon": { "type": "string", "maxLength": 8, "description": "알림 제목 앞 이모지 하나" },
        "description": { "type": "string", "description": "화면에서 무엇이 보이는지" },
        "point": { "type": "string", "description": "현장 포인트" },
        "interval": {
          "description": "자동 발생 간격(초). [최소, 최대] 사이에서 무작위. eventTiming 이 있으면 쓰지 않는다",
          "type": "array",
          "items": { "type": "number", "exclusiveMinimum": 0 },
          "minItems": 2,
          "maxItems": 2
        },
        "duration": { "type": "number", "exclusiveMinimum": 0, "description": "지속 시간(초)" },
        "effect": { "$ref": "#/definitions/effect" }
      }
    }
  }
}
